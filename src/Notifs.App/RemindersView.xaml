<UserControl x:Class="Notifs.App.RemindersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Notifs.App">
  <UserControl.Resources>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="Background" Value="{DynamicResource Background}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Line}" CornerRadius="5" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="MinHeight" Value="46"/><Setter Property="FontSize" Value="15"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}"/>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}"/></Trigger></Style.Triggers></Style></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource MutedInk}" BorderThickness="1" CornerRadius="8"><Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Ink}" StrokeThickness="1.7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="14,8,34,8" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></Border></Popup>
      </Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource Background}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,24"><TextBlock Text="{Binding Heading}" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Повторяющиеся сигналы и дела — в одном месте." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel>
    <StackPanel Grid.Row="1" Visibility="{Binding HasMessage, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"><TextBlock Text="{Binding Message}" FontSize="14" AutomationProperties.LiveSetting="Assertive"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Primary}"/><Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="Повторить" Command="{Binding RefreshCommand}" Visibility="{Binding CanRetry, Converter={StaticResource BoolVisibility}}" HorizontalAlignment="Left" Margin="0,6,0,0"/></StackPanel>
    <Grid Grid.Row="2" Visibility="{Binding IsList, Converter={StaticResource BoolVisibility}}">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid x:Name="ListHeading" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding CountLabel}" FontSize="11" Foreground="{DynamicResource MutedInk}" VerticalAlignment="Center" Margin="0,0,22,8"/><Button x:Name="NewReminder" Grid.Column="1" HorizontalAlignment="Right" Content="+  Новое напоминание" Command="{Binding NewCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8"/></Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}" Margin="0,24"><TextBlock Text="Пока нет напоминаний" FontSize="22"/><TextBlock Text="Добавьте простой сигнал по дням недели или каждый час." Style="{StaticResource MutedText}" Margin="0,12,0,0"/></StackPanel>
          <ItemsControl ItemsSource="{Binding Signals}" AutomationProperties.Name="Расписания напоминаний"><ItemsControl.ItemTemplate><DataTemplate>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,12">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Selected}" CornerRadius="12" Width="38" Height="40" VerticalAlignment="Top"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsNarrow, RelativeSource={RelativeSource AncestorType=local:RemindersView}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><Path Data="M3,13 H15 L13,10 V6 A4,4 0 0 0 5,6 V10 Z M7,16 Q9,19 11,16" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Primary}" StrokeThickness="1.7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="20,0,0,0"/><Style.Triggers><DataTrigger Binding="{Binding IsNarrow, RelativeSource={RelativeSource AncestorType=local:RemindersView}}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Primary}"/><TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,4"/><TextBlock Text="{Binding ScheduleLabel}" Style="{StaticResource MutedText}"/>
                  <WrapPanel Margin="0,12,0,0"><Button Content="Изменить" Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=local:RemindersView}}" CommandParameter="{Binding}" Margin="0,0,8,8"/><Button Content="{Binding ToggleLabel}" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=local:RemindersView}}" CommandParameter="{Binding}" Margin="0,0,8,8"/><Button Content="Удалить" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=local:RemindersView}}" CommandParameter="{Binding}" Foreground="{DynamicResource Danger}" Margin="0,0,0,8"/></WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <ScrollViewer Grid.Row="2" x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsEditing, Converter={StaticResource BoolVisibility}}">
      <StackPanel MaxWidth="700" HorizontalAlignment="Left" x:Name="Form" IsEnabled="{Binding CanEdit}">
        <Label Content="Название *" Target="{Binding ElementName=TitleInput}" FontWeight="SemiBold"/><TextBox x:Name="TitleInput" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.Name="Название напоминания, обязательное поле"/>
        <Grid x:Name="ModeFields" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="0,0,8,18"><Label Content="Режим" Target="{Binding ElementName=ModeInput}" FontWeight="SemiBold"/><ComboBox x:Name="ModeInput" SelectedIndex="0" AutomationProperties.Name="Режим напоминания"><ComboBoxItem Content="Простой сигнал"/></ComboBox></StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,0,18"><Label Content="Повторение" Target="{Binding ElementName=RepeatInput}" FontWeight="SemiBold"/><ComboBox x:Name="RepeatInput" SelectedIndex="{Binding RepeatIndex}" AutomationProperties.Name="Повторение напоминания"><ComboBoxItem Content="По дням недели"/><ComboBoxItem Content="Каждый час"/><ComboBoxItem Content="После выполнения" IsEnabled="False" ToolTip="Простой сигнал не требует выполнения."/></ComboBox></StackPanel>
        </Grid>
        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="22">
          <StackPanel><TextBlock Text="Когда напоминать" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Первое срабатывание ограничивает начало расписания. После выполнения недоступно: простой сигнал не требует отметки «Готово»." Style="{StaticResource MutedText}" Margin="0,8,0,18"/>
            <Grid x:Name="StartFields"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel Margin="0,0,8,18"><Label Content="Первое срабатывание, дата" Target="{Binding ElementName=FirstDateInput}" FontWeight="SemiBold"/><TextBox x:Name="FirstDateInput" Text="{Binding FirstDate, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Дата первого срабатывания, ДД.ММ.ГГГГ"/></StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,0,18"><Label Content="Местное время" Target="{Binding ElementName=FirstTimeInput}" FontWeight="SemiBold"/><TextBox x:Name="FirstTimeInput" Text="{Binding FirstTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Время первого срабатывания, ЧЧ:ММ"/></StackPanel>
            </Grid>
            <StackPanel Visibility="{Binding Weekly, Converter={StaticResource BoolVisibility}}"><TextBlock Text="Дни недели" FontSize="13" FontWeight="SemiBold"/><ItemsControl x:Name="DaysInput" ItemsSource="{Binding Days}" AutomationProperties.Name="Дни недели"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" Margin="0,0,14,0" AutomationProperties.Name="{Binding Label}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Label Content="Время по дням недели" Target="{Binding ElementName=WeeklyTimeInput}"/><TextBox x:Name="WeeklyTimeInput" Text="{Binding WeeklyTime, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Время по дням недели, ЧЧ:ММ"/></StackPanel>
            <StackPanel Visibility="{Binding Hourly, Converter={StaticResource BoolVisibility}}"><Label Content="Минута каждого часа (0–59)" Target="{Binding ElementName=MinuteInput}" FontWeight="SemiBold"/><TextBox x:Name="MinuteInput" Text="{Binding Minute, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Минута каждого часа, от 0 до 59"/></StackPanel>
          </StackPanel>
        </Border>
        <Label Content="Содержание сигнала" Target="{Binding ElementName=DescriptionInput}" FontWeight="SemiBold" Margin="0,20,0,0"/><TextBox x:Name="DescriptionInput" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="90" AutomationProperties.Name="Содержание сигнала"/>
        <CheckBox Content="Напоминание включено" IsChecked="{Binding Enabled}" Margin="0,16,0,12"/>
        <WrapPanel Margin="0,8,0,0"><Button Content="Сохранить напоминание" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8"/><Button Content="К напоминаниям" Command="{Binding CancelCommand}" Margin="0,0,0,8"/></WrapPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
