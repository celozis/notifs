<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="Primary" Color="#E5B666" />
  <SolidColorBrush x:Key="PrimaryHover" Color="#F0C57F" />
  <SolidColorBrush x:Key="PrimaryPressed" Color="#D5A656" />
  <SolidColorBrush x:Key="OnPrimary" Color="#282014" />
  <SolidColorBrush x:Key="Background" Color="#20211F" />
  <SolidColorBrush x:Key="Surface" Color="#292C27" />
  <SolidColorBrush x:Key="Ink" Color="#F1F0E6" />
  <SolidColorBrush x:Key="MutedInk" Color="#BDC0B1" />
  <SolidColorBrush x:Key="Line" Color="#505646" />
  <SolidColorBrush x:Key="Selected" Color="#38382B" />
  <SolidColorBrush x:Key="Danger" Color="#FFB5AE" />
  <SolidColorBrush x:Key="Navigation" Color="#181A17" />
  <SolidColorBrush x:Key="Hover" Color="#393C33" />
  <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
  <FontFamily x:Key="CodeFont">Consolas</FontFamily>
  <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  <Style x:Key="FocusOutline">
    <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Rectangle Stroke="{DynamicResource Primary}" StrokeThickness="2" StrokeDashArray="2 1" Margin="2" RadiusX="6" RadiusY="6" />
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource Background}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>
  <Style TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="24" />
    <Setter Property="LineStackingStrategy" Value="MaxHeight" />
  </Style>
  <Style x:Key="MutedText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedInk}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="21" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
      </Border>
      <Border x:Name="HoverRing" IsHitTestVisible="False" BorderBrush="{DynamicResource Primary}" BorderThickness="1" CornerRadius="8" Opacity="0" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverRing" Property="Opacity" Value="1" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45" /></Trigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
            <Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
          </MultiDataTrigger.Conditions>
          <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" FillBehavior="Stop" /></Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
          <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.12" FillBehavior="Stop" /></Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
        </MultiDataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Selected}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Primary}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryHover}" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryPressed}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style x:Key="CompletionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid Width="44" Height="44" Background="Transparent">
        <Ellipse x:Name="Circle" Width="28" Height="28" Stroke="{DynamicResource MutedInk}" Fill="Transparent"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource Primary}"/><Setter TargetName="Circle" Property="Fill" Value="{DynamicResource Selected}"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource Primary}"/><Setter TargetName="Circle" Property="StrokeThickness" Value="2"/></Trigger>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter TargetName="Circle" Property="Fill" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/></DataTrigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource MutedInk}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
      <Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Background="{DynamicResource Background}" Padding="6,10"><ContentPresenter ContentSource="Header"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Primary}"/><Setter Property="Foreground" Value="{DynamicResource Primary}"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Primary}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MutedInk}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Selected}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Primary}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True">
      <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
    </Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Card" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
        <Grid><Border x:Name="SelectionBar" Background="{DynamicResource Primary}" Width="3" HorizontalAlignment="Left" Margin="-16,-12,0,-12" Visibility="Collapsed" /><ContentPresenter /></Grid>
      </Border>
      <ControlTemplate.Triggers>
        <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="0.78" Duration="0:0:0"/></Storyboard></BeginStoryboard></EventTrigger>
        <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0"/></Storyboard></BeginStoryboard></EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0"/></Storyboard></BeginStoryboard></EventTrigger>
        <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Background}"/></DataTrigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SelectionBar" Property="Visibility" Value="Visible"/><Setter TargetName="Card" Property="Background" Value="{DynamicResource Hover}" /><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Primary}" /></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Primary}" /><Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" /></Trigger>
        <Trigger Property="IsMouseCaptured" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Selected}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectionBar" Property="Visibility" Value="Visible" /><Setter TargetName="Card" Property="Background" Value="{DynamicResource Selected}" /><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Primary}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Label"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Padding" Value="0,0,0,8" /></Style>
</ResourceDictionary>
