<UserControl x:Class="Notifs.App.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,26"><TextBlock Text="Настройки" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Спокойная работа — по твоим правилам." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="22" VerticalAlignment="Top" MaxWidth="700" HorizontalAlignment="Stretch"><StackPanel IsEnabled="{Binding CanEdit}">
      <TextBlock Text="Уведомления" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Карточки не забирают фокус и остаются до закрытия." Style="{StaticResource MutedText}" Margin="0,10,0,20"/>
      <Label Content="Обычное откладывание, минут" Target="{Binding ElementName=SnoozeInput}"/><TextBox x:Name="SnoozeInput" Text="{Binding SnoozeMinutes, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Обычное откладывание в минутах"/>
      <CheckBox Content="Короткий негромкий звук" IsChecked="{Binding Sound}" Foreground="{DynamicResource Ink}" MinHeight="44" Margin="0,20,0,12"/>
      <TextBlock Text="До двух карточек на основном мониторе. Новая появляется снизу." Style="{StaticResource MutedText}"/>
    </StackPanel></Border></ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,20,0,0"><TextBlock Text="{Binding Message}" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"/><Button Content="Сохранить настройки" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel>
  </Grid>
</UserControl>
